<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.wtg.views.ClientsController"
            stylesheets="@style.css"
            styleClass="root-pane">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16" styleClass="navbar">
            <padding><Insets top="14" right="24" bottom="14" left="24"/></padding>
            <Label text="WorkTogether — Clients" styleClass="nav-logo"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="← Retour" onAction="#onRetour" styleClass="btn-logout"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true" styleClass="scroll-pane">
            <VBox spacing="24">
                <padding><Insets top="32" right="40" bottom="40" left="40"/></padding>

                <VBox spacing="6">
                    <Label text="Clients" styleClass="page-title"/>
                    <Label text="Liste des entreprises clientes et leur activité." styleClass="page-subtitle"/>
                </VBox>

                <!-- Stats -->
                <HBox spacing="16">
                    <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                        <Label text="CLIENTS TOTAUX" styleClass="stat-label"/>
                        <Label fx:id="statTotal" text="—" styleClass="stat-value"/>
                    </VBox>
                    <VBox styleClass="stat-card stat-card-ok" HBox.hgrow="ALWAYS">
                        <Label text="CLIENTS ACTIFS" styleClass="stat-label"/>
                        <Label fx:id="statActifs" text="—" styleClass="stat-value"/>
                    </VBox>
                    <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                        <Label text="CLIENTS INACTIFS" styleClass="stat-label"/>
                        <Label fx:id="statInactifs" text="—" styleClass="stat-value"/>
                    </VBox>
                    <VBox styleClass="stat-card stat-card-warn" HBox.hgrow="ALWAYS">
                        <Label text="UNITÉS LOUÉES" styleClass="stat-label"/>
                        <Label fx:id="statUnites" text="—" styleClass="stat-value"/>
                    </VBox>
                </HBox>

                <!-- Table + PieChart -->
                <HBox spacing="20" VBox.vgrow="ALWAYS">

                    <VBox spacing="12" styleClass="card" HBox.hgrow="ALWAYS">
                        <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                        <Label text="LISTE DES CLIENTS" styleClass="section-title"/>
                        <TextField fx:id="rechercheField"
                                   promptText="🔍  Rechercher par email…"
                                   styleClass="text-field"/>
                        <TableView fx:id="clientsTable" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="emailCol"    text="Email"         prefWidth="300"/>
                                <TableColumn fx:id="cmdCol"      text="Commandes"     prefWidth="120"/>
                                <TableColumn fx:id="unitesCol"   text="Unités louées" prefWidth="130"/>
                            </columns>
                            <placeholder><Label text="Aucun client enregistré."/></placeholder>
                        </TableView>
                    </VBox>

                    <VBox spacing="12" styleClass="card" prefWidth="380">
                        <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                        <Label text="RÉPARTITION CLIENTS" styleClass="section-title"/>
                        <PieChart fx:id="pieClients"
                                  labelsVisible="true"
                                  legendVisible="true"
                                  VBox.vgrow="ALWAYS"
                                  prefHeight="320"/>
                    </VBox>

                </HBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
