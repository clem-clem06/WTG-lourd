# ============================================================
#  MODÈLE — à copier en application.properties (git-ignoré).
#    cp application.properties.example application.properties
#
#  Profil par défaut = "prod" → le .jar distribué se connecte à la prod
#  (valeurs dans application-prod.properties, voir son .example).
#  En dev, le profil "dev" est forcé :
#    - via Gradle : `gradlew bootRun` (déjà configuré dans build.gradle)
#    - via IntelliJ : Run config → VM options → -Dspring.profiles.active=dev
# ============================================================
spring.profiles.active=${APP_ENV:prod}

# ── BDD : valeurs DEV par défaut (surchargées par le profil prod) ──
spring.datasource.url=${DB_URL:jdbc:mysql://127.0.0.1:3306/worktogether?serverTimezone=Europe/Paris&useSSL=false&allowPublicKeyRetrieval=true}
spring.datasource.username=${DB_USER:root}
spring.datasource.password=${DB_PASSWORD:}
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# ── JPA / Hibernate ──
spring.jpa.hibernate.ddl-auto=none
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect

# ── Logs (false en prod, true en dev pour voir le SQL) ──
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.format_sql=false
logging.level.org.hibernate.SQL=WARN
logging.level.org.springframework=WARN
