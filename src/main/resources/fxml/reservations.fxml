<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.wtg.views.ReservationsController"
            stylesheets="@style.css"
            styleClass="root-pane">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16" styleClass="navbar">
            <padding><Insets top="14" right="24" bottom="14" left="24"/></padding>
            <Label text="WorkTogether — Réservations" styleClass="nav-logo"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="← Retour" onAction="#onRetour" styleClass="btn-logout"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true" styleClass="scroll-pane">
            <VBox spacing="24">
                <padding><Insets top="32" right="40" bottom="40" left="40"/></padding>

                <VBox spacing="6">
                    <Label text="Réservations" styleClass="page-title"/>
                    <Label text="Suivi de toutes les commandes et de leur statut." styleClass="page-subtitle"/>
                </VBox>

                <!-- Stats -->
                <HBox spacing="16">
                    <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                        <Label text="COMMANDES TOTALES" styleClass="stat-label"/>
                        <Label fx:id="statTotal" text="—" styleClass="stat-value"/>
                    </VBox>
                    <VBox styleClass="stat-card stat-card-ok" HBox.hgrow="ALWAYS">
                        <Label text="PAYÉES" styleClass="stat-label"/>
                        <Label fx:id="statPayees" text="—" styleClass="stat-value"/>
                    </VBox>
                    <VBox styleClass="stat-card stat-card-warn" HBox.hgrow="ALWAYS">
                        <Label text="EN ATTENTE" styleClass="stat-label"/>
                        <Label fx:id="statAttente" text="—" styleClass="stat-value"/>
                    </VBox>
                    <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                        <Label text="REVENU TOTAL (payé)" styleClass="stat-label"/>
                        <Label fx:id="statRevenu" text="—" styleClass="stat-value"/>
                    </VBox>
                </HBox>

                <Label fx:id="feedbackLabel" visible="false" managed="false" wrapText="true" maxWidth="Infinity"/>

                <!-- Table + BarChart -->
                <HBox spacing="20" VBox.vgrow="ALWAYS">

                    <VBox spacing="12" styleClass="card" HBox.hgrow="ALWAYS">
                        <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                        <Label text="LISTE DES COMMANDES" styleClass="section-title"/>
                        <TextField fx:id="rechercheField"
                                   promptText="🔍  Rechercher par client, statut…"
                                   styleClass="text-field"/>
                        <TableView fx:id="ordersTable" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="clientCol"  text="Client"   prefWidth="240"/>
                                <TableColumn fx:id="totalCol"   text="Montant"  prefWidth="110"/>
                                <TableColumn fx:id="statusCol"  text="Statut"   prefWidth="120"/>
                                <TableColumn fx:id="dateCol"    text="Date"     prefWidth="160"/>
                            </columns>
                            <placeholder><Label text="Aucune commande enregistrée."/></placeholder>
                        </TableView>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Button fx:id="validerBtn" text="✓ Valider le paiement"
                                    onAction="#onValider" disable="true" styleClass="btn-login"/>
                            <Button fx:id="annulerBtn" text="✗ Annuler"
                                    onAction="#onAnnuler" disable="true" styleClass="btn-delete"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="selectionHint" text="Aucune sélection" styleClass="selection-hint"/>
                        </HBox>
                    </VBox>

                    <VBox spacing="12" styleClass="card" prefWidth="400">
                        <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                        <Label text="COMMANDES PAR STATUT" styleClass="section-title"/>
                        <BarChart fx:id="barStatut"
                                  VBox.vgrow="ALWAYS"
                                  prefHeight="320"
                                  legendVisible="true"
                                  animated="false">
                            <xAxis><CategoryAxis label="Statut"/></xAxis>
                            <yAxis><NumberAxis label="Nb commandes"/></yAxis>
                        </BarChart>
                    </VBox>

                </HBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
